{% extends 'demo/layouts/base' %}

{% block title %}{{ page.title | escape }}{% endblock %}

{% block styles %}

        body {
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(circle at 12% 10%, rgba(45, 212, 191, .2), transparent 30rem),
                radial-gradient(circle at 85% 5%, rgba(96, 165, 250, .2), transparent 32rem),
                #07111f;
        }

        main { width: min(1080px, calc(100% - 32px)); margin: 0 auto; padding: 72px 0; }
        .eyebrow { color: #5eead4; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
        h1 { max-width: 720px; margin: 12px 0; font-size: clamp(2.4rem, 7vw, 5rem); line-height: .98; }
        .lead { max-width: 680px; color: #a8b7cc; font-size: 1.1rem; line-height: 1.7; }
        .grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 24px; margin-top: 48px; }
        .card { border: 1px solid #233651; border-radius: 24px; background: rgba(12, 27, 46, .84); box-shadow: 0 24px 80px rgba(0, 0, 0, .25); }
        .product { padding: 32px; }
        .product-visual { display: grid; place-items: center; min-height: 260px; margin-bottom: 28px; border-radius: 18px; background: linear-gradient(145deg, #143855, #0b1c31); font-size: 6rem; }
        .status { display: inline-flex; align-items: center; gap: 8px; color: #6ee7b7; font-weight: 700; }
        .status::before { width: 8px; height: 8px; border-radius: 50%; background: currentColor; content: ""; box-shadow: 0 0 14px currentColor; }
        .status.sold-out { color: #fda4af; }
        h2 { margin: 14px 0 8px; font-size: 2rem; }
        .price { margin: 0; color: #5eead4; font-size: 1.7rem; font-weight: 800; }
        .description { color: #a8b7cc; line-height: 1.65; }
        .tags { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
        .tags li { padding: 7px 11px; border: 1px solid #31506e; border-radius: 999px; color: #c8d8eb; font-size: .82rem; }
        .panel { padding: 28px; }
        .panel h3 { margin: 0 0 18px; font-size: 1.15rem; }
        .variant { display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; border-top: 1px solid #20334b; }
        .variant:first-of-type { border-top: 0; }
        .muted { color: #6f8198; }
        pre { overflow-x: auto; margin: 24px 0 0; padding: 20px; border: 1px solid #20334b; border-radius: 16px; background: #050b14; color: #bfdbfe; line-height: 1.6; }
        .lesson { margin-top: 24px; }

        @media (max-width: 760px) {
            main { padding: 44px 0; }
            .grid { grid-template-columns: 1fr; }
        }
{% endblock %}

{% block content %}
<main>
    <header>
        <div class="eyebrow">{{ page.eyebrow | upcase | escape }}</div>
        <h1>{{ page.title | escape }}</h1>
        <p class="lead">{{ page.description | escape }}</p>
    </header>

    <section class="grid">
        <article class="card product">
            <div class="product-visual" aria-hidden="true">◉</div>

            {% if product.available %}
                <span class="status">现货，可立即发出</span>
            {% else %}
                <span class="status sold-out">暂时缺货</span>
            {% endif %}

            <h2>{{ product.title | escape }}</h2>
            <p class="price">{{ product.price | escape }}</p>
            <p class="description">{{ product.description | escape }}</p>

            <ul class="tags">
                {% for tag in product.tags %}
                    <li>#{{ tag | escape }}</li>
                {% endfor %}
            </ul>
        </article>

        <div>
            <section class="card panel">
                <h3>款式（{{ product.variants | size }}）</h3>

                {% for variant in product.variants %}
                    <div class="variant">
                        <span>{{ forloop.index }}. {{ variant.title | escape }}</span>
                        <span>
                            {{ variant.price | escape }} ·
                            {% if variant.available %}可选{% else %}<span class="muted">售罄</span>{% endif %}
                        </span>
                    </div>
                {% endfor %}
            </section>

            <section class="card panel lesson">
                <h3>本页用到的 Liquid 语法</h3>
                <pre><code>{% raw %}{{ product.title | escape }}

{% if product.available %}
  现货
{% else %}
  缺货
{% endif %}

{% for variant in product.variants %}
  {{ forloop.index }}. {{ variant.title }}
{% endfor %}{% endraw %}</code></pre>
            </section>
        </div>
    </section>
</main>
{% endblock %}
