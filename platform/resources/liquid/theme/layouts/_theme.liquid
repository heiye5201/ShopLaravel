<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title | escape }} · {{ shop.name | escape }}</title>
    <style>
        :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #07111f; color: #e8f0ff; }
        * { box-sizing: border-box; }
        body { min-height: 100vh; margin: 0; background: radial-gradient(circle at 14% 0, rgba(45, 212, 191, .2), transparent 34rem), #07111f; }
        a { color: inherit; }
        .shell { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
        .site-header { position: sticky; z-index: 2; top: 0; border-bottom: 1px solid rgba(49, 80, 110, .75); background: rgba(7, 17, 31, .86); backdrop-filter: blur(18px); }
        .site-header .shell { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 24px; }
        .brand { color: #99f6e4; font-size: 1.05rem; font-weight: 900; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
        nav { display: flex; gap: 8px; }
        nav a { padding: 8px 11px; border-radius: 999px; color: #a8b7cc; font-size: .9rem; text-decoration: none; }
        nav a:hover { background: #17375e; color: #fff; }
        main { padding: 72px 0 88px; }
        .hero { display: grid; grid-template-columns: 1.2fr .8fr; align-items: end; gap: 34px; margin-bottom: 52px; }
        .eyebrow { color: #5eead4; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
        h1 { max-width: 760px; margin: 12px 0 0; font-size: clamp(3rem, 8vw, 6.4rem); line-height: .93; }
        .lead { color: #a8b7cc; font-size: 1.1rem; line-height: 1.7; }
        .products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
        .product-card { overflow: hidden; border: 1px solid #29425f; border-radius: 20px; background: rgba(10, 25, 44, .9); }
        .product-card img { width: 100%; aspect-ratio: 12 / 7; object-fit: cover; }
        .product-card__body { padding: 20px; }
        .badge { display: inline-block; padding: 5px 9px; border: 1px solid #3b6d73; border-radius: 999px; color: #99f6e4; font-size: .74rem; font-weight: 700; }
        .product-card h2 { margin: 14px 0 7px; font-size: 1.2rem; }
        .product-card h2 a { text-decoration: none; }
        .product-card h2 a:hover { color: #99f6e4; }
        .product-card p { min-height: 48px; margin: 0; color: #8fa2ba; line-height: 1.5; }
        .price { display: block; margin-top: 18px; color: #5eead4; font-size: 1.25rem; font-weight: 900; }
        .product-detail { display: grid; grid-template-columns: 1.1fr .9fr; overflow: hidden; border: 1px solid #29425f; border-radius: 24px; background: rgba(10, 25, 44, .9); }
        .product-detail img { width: 100%; height: 100%; min-height: 420px; object-fit: cover; }
        .product-detail__body { align-self: center; padding: clamp(28px, 5vw, 58px); }
        .product-detail h1 { margin: 18px 0; font-size: clamp(2.4rem, 5vw, 4.6rem); }
        .product-detail p { color: #a8b7cc; font-size: 1.1rem; line-height: 1.7; }
        .architecture { margin-top: 38px; padding: 24px; border: 1px solid #29425f; border-radius: 20px; background: #050b14; }
        .architecture h2 { margin-top: 0; }
        .tree { overflow-x: auto; margin: 0; color: #bfdbfe; line-height: 1.7; }
        .site-footer { border-top: 1px solid #20334b; color: #788ba3; }
        .site-footer .shell { display: flex; justify-content: space-between; gap: 20px; padding: 30px 0; }
        @media (max-width: 780px) { .hero, .products, .product-detail { grid-template-columns: 1fr; } .site-header .shell, .site-footer .shell { align-items: start; flex-direction: column; padding: 18px 0; } nav { flex-wrap: wrap; } }
    </style>
</head>
<body>
    {% include 'theme/partials/header' %}

    <main class="shell">
        {% block content %}{% endblock %}
    </main>

    {% include 'theme/partials/footer' %}
</body>
</html>
